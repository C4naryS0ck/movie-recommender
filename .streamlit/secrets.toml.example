# Copy to .streamlit/secrets.toml (git-ignored) and fill in. Never commit the real file.

# Public address of the deployed app (used by serve.py for SEO tags and the sitemap)
SITE_URL = "https://your-app.streamlit.app"

# ---- admin sign-in (Google) ----
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # change to https://<your-app>/oauth2callback when deployed
cookie_secret = "paste-a-long-random-string-here"       # python -c "import secrets; print(secrets.token_hex(32))"
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "xxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Only these Google accounts get admin access
[admin]
emails = ["you@gmail.com"]

# ---- feedback storage (Supabase) ----
# Supabase → your project → Connect → "Session pooler" URI, with your database password filled in
[database]
url = "postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
